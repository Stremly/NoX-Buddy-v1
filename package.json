{
  "name": "electron-fastapi-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "npx electron .",
    "dev": "concurrently \"npm run start-react\" \"npm run start-electron\"",
    "start-react": "cd frontend && npm start",
    "start-electron": "wait-on http://localhost:3000 && electron .",
    "build": "cd frontend && npm run build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.noxbuddy.app",
    "productName": "NoX-Buddy",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/build/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
    "backend/**"
  ],
    "extraResources": [
      {
        "from": "backend/dist/",
        "to": "backend/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
   "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^17.2.3",
    "wait-on": "^7.0.0",
    "concurrently": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  }
}
